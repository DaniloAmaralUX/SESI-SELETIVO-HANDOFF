# Dependencies (qualquer nível, incl. app/node_modules)
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
dist-ssr/
build/
*.local

# Environment
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test coverage / artifacts
coverage/
**/__screenshots__/
.vitest-attachments/

# OS
.DS_Store
Thumbs.db

# Editores
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.sw?

# Ferramentas e configurações locais de assistente (não versionadas)
.claude/
.agents/

# Scratch: scripts e saídas temporários de investigação/evidência.
# Prefixe com ponto e "tmp" (ex.: .shots-tmp.mjs) para nunca virar commit.
*-tmp.*
*.tmp
.scratch/
screenshots/
