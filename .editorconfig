# Regras de formatação que valem em qualquer editor, inclusive sem plugin de
# Prettier. O Prettier continua sendo a autoridade para os arquivos que ele
# formata (.prettierrc) — aqui ficam o mínimo comum e os tipos que ele não cobre.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown usa dois espaços no fim da linha como quebra explícita
[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab
